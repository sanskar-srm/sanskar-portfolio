# ── Admin panel (/admin) ─────────────────────────────────────────────
# Generate the hash + a session secret with:  npm run hash-password -- "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ── Experience storage in production ────────────────────────────────
# Add the Upstash Redis integration in Vercel (Storage → Upstash) and these are set for you.
# Without them, entries are saved to data/experience.json (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Contact form ────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Genkit (only used by the optional AI description flow) ──────────
GEMINI_API_KEY=
